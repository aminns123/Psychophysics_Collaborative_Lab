# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local virtual environments / build artefacts
.venv/
.venv.incompatible-*/
build/
dist/
*.egg-info/

# Local PsyCoLab machine preference (stores only the last data-folder path)
.psycolab_local.json

# Logs / temporary files
*.log
tmp/
temp/

# Optional local runtime data if a user deliberately chooses this historical
# sibling-folder name inside a working tree. The TUI now rejects data folders
# inside/above the repository and recommends an adjacent folder instead.
local_psychophysics_data/

# Local editor/runtime diagnostics (never part of the shared laboratory code)
.vscode/
.psycolab_logs/
.idea/
*.tmp
*.swp
*~
